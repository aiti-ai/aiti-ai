{
  "name": "@aiti-ai/pi-model-command",
  "version": "0.1.0",
  "description": "Register /models so any pi host (TUI, RPC, SDK) can switch the session model from the composer: /models opens a picker, /models <provider/modelId> sets one directly. A pi package.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "model",
    "slash-command"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "pi-plugins/pi-model-command"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  }
}
