{
  "name": "@aiti-ai/pi-session-search",
  "version": "0.1.0",
  "description": "Give the pi agent session_search / session_read tools: full-text search across past sessions (optionally every agent family via a pi-web session-manager index) and read original messages — recover context lost to compaction, find how something was done before. A pi package.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "session-search",
    "history",
    "compaction",
    "fts5"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "pi-plugins/pi-session-search"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  }
}
