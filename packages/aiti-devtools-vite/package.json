{
  "name": "@aiti-ai/aiti-devtools-vite",
  "version": "0.1.1",
  "description": "Vite carrier plugin: dev-server-embedded bridge/MCP (same-origin /aiti/) + automatic launcher injection + MCP auto-registration at startup; works for SvelteKit and any Vite project; dev-only, zero injection in production builds.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./astro": "./dist/astro.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@aiti-ai/aiti-devtools-core": "^0.3.5"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.js --target=es2022 --platform=node --external:@aiti-ai/aiti-devtools-core --external:vite && esbuild src/astro.ts --bundle --format=esm --outfile=dist/astro.js --target=es2022 --platform=node --external:@aiti-ai/aiti-devtools-core"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "packages/aiti-devtools-vite"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
