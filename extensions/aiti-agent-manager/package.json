{
  "name": "@aiti-ai/aiti-agent-manager",
  "version": "0.2.9",
  "description": "Unified aggregation of external agent login states + login action proxying + multi-account profiles (backup/alias/one-click switch) + account quota display — implements no login protocol at all",
  "soul": "六家 agent 登录态，一屏看尽；多账号穿换，一键切换。",
  "scripts": {
    "build:client": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const f of fs.readdirSync('client/src'))if(f.endsWith('.mjs'))fs.copyFileSync('client/src/'+f,'dist/'+f)\""
  },
  "aitiConfigs": {
    "configFiles": [
      "agent-accounts.json"
    ]
  },
  "aitiExtProtocol": "1.0",
  "dependencies": {
    "@aiti-ai/ext-shared": "^0.1.12"
  },
  "license": "MIT",
  "contentHash": "e1569c522adc7d07",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "extensions/aiti-agent-manager"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  }
}
