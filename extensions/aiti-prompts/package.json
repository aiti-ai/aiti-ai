{
  "name": "@aiti-ai/aiti-prompts",
  "version": "0.1.0",
  "type": "module",
  "description": "aiti prompt 片段收藏库（收藏/会话提取/一键插队排队）—— JSX + vite 构建 client bundle",
  "scripts": {
    "build:client": "vite build --config vite.config.ts",
