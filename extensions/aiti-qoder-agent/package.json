{
  "name": "@aiti-ai/aiti-qoder-agent",
  "version": "0.4.5",
  "description": "Qoder CLI backend — stream-json driving + account credits via quota API (agentKey: qoder)",
  "soul": "别人走 ACP 大路，它偏要走签名的独木桥——因为风景在对面。",
  "scripts": {
    "build:client": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const f of fs.readdirSync('client/src'))if(f.endsWith('.mjs'))fs.copyFileSync('client/src/'+f,'dist/'+f)\""
  },
  "aitiConfigs": {
    "configFiles": [
      "zcode-api-key.json",
      "controlled-login.json"
    ]
  },
  "aitiExtProtocol": "1.0",
  "dependencies": {
    "@aiti-ai/ext-shared": "^0.1.7"
  },
  "license": "MIT"
}
