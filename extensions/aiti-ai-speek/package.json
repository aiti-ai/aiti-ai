{
  "name": "@aiti-ai/aiti-ai-speek",
  "version": "0.2.5",
  "type": "module",
  "description": "Voice reading of AI output — browser Web Speech / edge-tts / local TTS (Hojo-TTS-Light, OpenAI-compatible) with cache, voice cloning and pause/skip/stop",
  "displayNameI18n": {
    "en": "AI Read Aloud"
  },
  "descriptionI18n": {
    "zh-CN": "AI 输出语音朗读——可切音色/暂停/跳过/停止；默认浏览器 Web Speech，可选 edge-tts"
  },
  "scripts": {
    "build:client": "vite build --config vite.config.ts",
    "watch": "vite build --watch --config vite.config.ts",
    "deploy": "node tools/deploy.mjs",
    "test": "node --test tools/*.test.mjs"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "soul": "你打字，它读给你听。",
  "soulI18n": {
    "en": "You type, it reads it back to you."
  },
  "aitiConfigs": {
    "configFiles": [
      "steer-injected.json",
      "edge-auto-enabled.json",
      "local-auto-enabled.json"
    ]
  },
  "aitiExtProtocol": "1.0",
  "license": "MIT",
  "contentHash": "08290bca2e5c6eec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "extensions/aiti-ai-speek"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai-speek#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  },
  "dependencies": {
    "@aiti-ai/ext-shared": "^0.1.22"
  }
}
