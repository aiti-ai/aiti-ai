    try {
      const r = hlCtx.rowElement.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) {
        drawRects = [{ left: r.left, top: r.top, width: r.width, height: r.height }];
      }
    } catch {
    }
  }
