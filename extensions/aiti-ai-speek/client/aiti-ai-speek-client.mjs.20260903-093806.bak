    layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:2147482000;";
    document.body.appendChild(layer);
  }
  layer.innerHTML = "";
  const merged = mergeRowRects(rects);
  for (const r of merged) {
    if (!r.width || !r.height) continue;
    const box = document.createElement("div");
    box.style.cssText = `position:fixed;left:${r.left}px;top:${r.top}px;width:${r.width}px;height:${r.height}px;border-radius:3px;background:color-mix(in srgb,var(--accent,#3b82f6) 24%,transparent);box-shadow:0 0 0 2px color-mix(in srgb,var(--accent,#3b82f6) 55%,transparent);`;
    layer.appendChild(box);
  }
  try {
    console.log("[aiti-ai-speek][hl] drawLayer", { rectCount: rects.length, mergedCount: merged.length, first: rects[0] || null });
  } catch {
  }
}
function findScrollableContainer(el) {
  let current = el.parentElement;
  while (current) {
