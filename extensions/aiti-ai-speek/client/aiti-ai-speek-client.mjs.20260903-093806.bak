            return {
              rects: [{ ...best.coordinates }],
              rowElement: best.element || null,
              // 匹配行的 DOM 元素（每帧重读坐标用）
              startNode: null,
              body: step2.body
            };
          } else {
            console.log("[aiti-ai-speek][hl] locateInMessages no row match", { bestScore, curText: text.slice(0, 30), rowCount: step2.rows.length });
