}
function leanText(text) {
  return String(text || "").replace(/\*\*([^*]+)\*\*/g, "$1").replace(/__([^_]+)__/g, "$1").replace(/\*([^*]+)\*/g, "$1").replace(/_([^_]+)_/g, "$1").replace(/^#{1,6}\s+/gm, "").replace(/\[([^\]]+)\]\([^)]+\)/g, "$1").replace(/!\[([^\]]*)\]\([^)]+\)/g, "$1").replace(/`([^`]+)`/g, "$1").replace(/^>\s+/gm, "").replace(/^[-*_]{3,}\s*$/gm, "").replace(/[“”]/g, '"').replace(/[‘’]/g, "'").replace(/…/g, "…").replace(/([\u4e00-\u9fff\u3000-\u303f\uff00-\uffef])[ \t\u00a0\u3000]+/g, "$1").replace(/[ \t\u00a0\u3000]+([\u4e00-\u9fff\u3000-\u303f\uff00-\uffef])/g, "$1").replace(/\n{3,}/g, "\n\n").trim();
}
function verbalize(text) {
  return String(text || "").replace(/√/g, "根号").replace(/≥/g, "大于等于").replace(/≤/g, "小于等于").replace(/≠/g, "不等于").replace(/≈/g, "约等于").replace(/×/g, "乘").replace(/÷/g, "除以");
}
function cleanMarkdown(text) {
