function mergeRowRects(rects) {
  if (!rects.length) return [];
  const norm = rects.filter((r) => r && typeof r.left === "number" && typeof r.top === "number" && r.width > 0 && r.height > 0).map((r) => ({ ...r, right: r.left + r.width })).sort((a, b) => a.top - b.top || a.left - b.left);
  if (!norm.length) return [];
  const merged = [];
  let row = { ...norm[0] };
  for (let i = 1; i < norm.length; i++) {
    const r = norm[i];
    const sameRow = Math.abs(r.top - row.top) < 4 && Math.abs(r.height - row.height) < 4;
    if (sameRow && r.left <= row.right + 4) {
      row.right = Math.max(row.right, r.right);
      row.width = row.right - row.left;
      row.height = Math.max(row.height, r.height);
    } else {
      merged.push(row);
      row = { ...r };
    }
  }
  merged.push(row);
  return merged.map(({ right, ...rest }) => rest);
}
function drawLayer(rects) {
