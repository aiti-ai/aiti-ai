}
function locateInMessages(text, sourceId, rawMarkdown) {
  console.log("[aiti-ai-speek][hl] locateInMessages start", { sourceId, textLen: (text || "").length });
  if (sourceId && rawMarkdown) {
    const el = document.querySelector('[data-entry-id="' + sourceId + '"]');
    if (el) {
      console.log("[aiti-ai-speek][hl] locateInMessages use new algorithm", { sourceId });
      const step2 = extractDOMRows(sourceId);
      if (step2.status === "ok" && step2.rows.length) {
        const curNorm = normKey(cleanMarkdown(text || ""));
        if (curNorm) {
          let best = null, bestScore = 0;
          for (const row of step2.rows) {
            const rowNorm = normKey(cleanMarkdown(row.text));
            if (!rowNorm) continue;
            let score = 0;
            if (rowNorm === curNorm) score = 1;
            else if (rowNorm.includes(curNorm) || curNorm.includes(rowNorm)) score = 0.9;
            else {
              let p = 0;
              const L = Math.min(rowNorm.length, curNorm.length);
              while (p < L && rowNorm[p] === curNorm[p]) p++;
              score = L ? p / L : 0;
            }
            if (score > bestScore) {
              bestScore = score;
              best = row;
            }
          }
          if (best && bestScore >= 0.6) {
            console.log("[aiti-ai-speek][hl] locateInMessages matched row", {
              rowIndex: best.lineIndex,
              score: bestScore,
              coordinates: best.coordinates,
              rowText: best.text.slice(0, 30),
              curText: text.slice(0, 30)
