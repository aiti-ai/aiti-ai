    try {
      const container = findScrollableContainer(rowEl);
      if (container) {
        const containerRect = container.getBoundingClientRect();
        const rowRect = rowEl.getBoundingClientRect();
        const rowCenterY = rowRect.top + rowRect.height / 2;
