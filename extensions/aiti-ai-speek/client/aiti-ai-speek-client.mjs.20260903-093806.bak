}
function extractDOMRows(sourceId) {
  console.log("[aiti-ai-speek][hl] STEP2 start", { sourceId });
  const rows = [];
  const el = sourceId ? document.querySelector('[data-entry-id="' + sourceId + '"]') : null;
  if (!el) {
    console.log("[aiti-ai-speek][hl] STEP2 no element", { sourceId });
    return { status: "no-element", rows: [] };
  }
  const body = el.querySelector(".markdown-body") || el;
  const blocks = Array.from(body.querySelectorAll("p,li,h1,h2,h3,h4,h5,h6,pre,tr,td"));
  if (!blocks.length) {
    blocks.push(body);
  }
  console.log("[aiti-ai-speek][hl] STEP2 blocks", { count: blocks.length });
  for (let bi = 0; bi < blocks.length; bi++) {
    const block = blocks[bi];
    const text = (block.textContent || "").trim();
    if (!text) continue;
    const clean = leanText(text);
    let rect = { left: 0, top: 0, width: 0, height: 0 };
    try {
      const br = block.getBoundingClientRect();
      if (br.width > 0 && br.height > 0) {
        rect = { left: br.left, top: br.top, width: br.width, height: br.height };
      }
    } catch (e) {
    }
    const row = {
      lineIndex: bi,
      text,
      lean: clean,
      coordinates: rect,
      element: block
      // 保留 DOM 元素引用，供每帧重读坐标
    };
    rows.push(row);
    console.log("[aiti-ai-speek][hl] STEP2 row", {
      index: bi,
      text: text.slice(0, 60),
      lean: clean.slice(0, 60),
      x: rect.left,
      y: rect.top,
      w: rect.width,
      h: rect.height
    });
  }
  console.log("[aiti-ai-speek][hl] STEP2 done", {
    totalRows: rows.length,
    firstRow: rows[0] ? { text: rows[0].text.slice(0, 40), x: rows[0].coordinates.left, y: rows[0].coordinates.top } : null
  });
