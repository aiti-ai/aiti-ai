{
  "name": "@aiti-ai/aiti-custom-agent",
  "version": "0.1.9",
  "description": "Register custom session backends with a UI form — launch command + args prefix + member env + bridge mode, hot effective on save; generic driver one-shot spawn (dockerized / command wrapping / multiple configs for the same CLI)",
  "soul": "一行命令，一个后端；docker 里跑 agent，从此不再手写配置。",
  "aitiConfigs": {
    "configFiles": [
      "agents.json"
    ]
  },
  "scripts": {
    "build:client": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('client/src/custom-agent-client.mjs','dist/custom-agent-client.mjs')\"",
    "deploy": "node tools/deploy.mjs"
  },
  "aitiExtProtocol": "1.0",
  "dependencies": {
    "@aiti-ai/ext-shared": "^0.1.12"
  },
  "license": "MIT",
  "contentHash": "8c835e3529b740e9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "extensions/aiti-custom-agent"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  }
}
