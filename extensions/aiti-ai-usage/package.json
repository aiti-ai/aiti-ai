    "watch": "vite build --watch --config vite.config.ts",
    "deploy": "node tools/deploy.mjs"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "soul": "用量不是账单来了才知道——每一枚 token 都该有去向。",
