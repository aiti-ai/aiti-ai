{
  "name": "@aiti-ai/aiti-plan-first",
  "version": "0.2.0",
  "type": "module",
  "description": "方案先行提醒扩展——结合 aiti-git-trace 事件感知：md 变更绑定向导 + 大改未跟方案提醒 + 一键插入「更新方案文档：@file」",
  "scripts": {
    "build:client": "vite build --config vite.config.ts",
    "watch": "vite build --watch --config vite.config.ts",
    "deploy": "node tools/deploy.mjs",
    "test": "node --test"
  },
  "devDependencies": {
    "vite": "^6.4.3"
  },
  "aitiConfigs": {
    "configFiles": [
      "plans.json"
    ]
  },
  "aitiExtProtocol": "1.0",
  "license": "MIT",
  "contentHash": "2a99ecec0023a4d7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "extensions/aiti-plan-first"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  },
  "descriptionI18n": {
    "en": "Plan-first reminder extension — listens to aiti-git-trace events: bind md changes to a wizard, flag large changes without a plan, and insert \"update plan doc: @file\" in one click"
  },
  "displayNameI18n": {
    "en": "Plan First"
  },
  "dependencies": {
    "@aiti-ai/ext-shared": "^0.1.22"
  }
}
