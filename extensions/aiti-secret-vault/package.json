{
  "name": "@aiti-ai/aiti-secret-vault",
  "version": "0.3.0",
  "type": "module",
  "description": "Encrypted secret vault management UI for pi-web: list / add / rotate / reveal / remove aliases, lock/unlock, switch between keyfile and OS-keychain unlock, and inspect which aliases are mounted per session. Values never enter the AI conversation.",
  "scripts": {
    "build:client": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const f of fs.readdirSync('client/src'))if(f.endsWith('.mjs'))fs.copyFileSync('client/src/'+f,'dist/'+f)\"",
    "deploy": "node tools/deploy.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aiti-ai/secret-vault-core": "^0.3.0"
  },
  "aitiExtProtocol": "1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiti-ai/aiti-ai.git",
    "directory": "extensions/aiti-secret-vault"
  },
  "homepage": "https://github.com/aiti-ai/aiti-ai#readme",
  "bugs": {
    "url": "https://github.com/aiti-ai/aiti-ai/issues"
  },
