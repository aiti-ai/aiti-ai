{
  "name": "@aiti-ai/aiti-claude-code-agent",
  "version": "0.1.2",
  "description": "Drive Claude Code CLI sessions — resume historical rows from All Sessions (agentKey: claude)",
  "soul": "历史会话不是化石——点一下就活过来。",
  "scripts": {
    "build:client": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const f of fs.readdirSync('client/src'))if(f.endsWith('.mjs'))fs.copyFileSync('client/src/'+f,'dist/'+f)\""
  },
  "aitiConfigs": {
    "configFiles": [
      "zcode-api-key.json",
      "controlled-login.json"
    ]
  },
  "aitiExtProtocol": "1.0",
  "dependencies": {
    "@aiti-ai/ext-shared": "^0.1.3"
  },
  "license": "MIT"
}
