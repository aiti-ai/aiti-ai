# aiti/aiti:full — all-in-one image (aiti-docker-image-plan §3.2)
# core + GUI (Xvfb/openbox/x11vnc/noVNC/dbus/at-spi/xdotool) + Chromium + ASR (faster-whisper/FunASR)
# + edge-tts + tunnel binaries (cloudflared/ngrok/frpc) + ttyd. Build args shared with core.
ARG CORE_IMAGE=aiti/aiti:core
FROM ${CORE_IMAGE}

# Official mirrors by default (GitHub-direct); CN local builds inject via build.sh --cn (shared with core)
ARG APT_MIRROR=""
ARG HF_ENDPOINT=https://huggingface.co
ARG PIP_MIRROR=https://pypi.org/simple
ENV DEBIAN_FRONTEND=noninteractive

# ── ① GUI system components (same list as aiti-ui-env setup-linux.sh, design §2.2.1) ──────────
# ⚠ R4 truth (2026-09-10 second-review correction): ubuntu 26.04's chromium-browser/chromium are both
# snap transition packages (2:1snap1-*); apt-installing them is a false success and unusable in-container
# (no snap) — the first-run "R4 resolved" was a misjudgment (first fallback link false-success + silent start).
# Browser: amd64 installs Google's official deb directly (not via the apt repo — the dl.google.com repo index
# Hit Hash Sum mismatch in practice; a direct deb has no index, deps resolve from the apt mirror). arm64 has no
# official Chrome deb and falls back to apt chromium (usable if the mirror carries a real deb, else WARN — arm64 browser support is a known gap).
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|http://archive.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g; s|http://security.ubuntu.com/ubuntu|http://${APT_MIRROR}/ubuntu|g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    if [ "$arch" = "amd64" ]; then \
      wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
        || wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb; \
      CHROME_DEB="/tmp/chrome.deb"; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      xvfb openbox \
      x11vnc novnc tigervnc-common \
      dbus-x11 at-spi2-core \
      xauth x11-utils xdotool wmctrl \
      xterm \
      ${CHROME_DEB:-}; \
    rm -f /tmp/chrome.deb; \
    rm -rf /var/lib/apt/lists/*; \
    if [ "$arch" != "amd64" ]; then \
      apt-get update && apt-get install -y --no-install-recommends chromium \
        || echo "[full] WARN: no official Chrome deb for arm64 and apt chromium unavailable (snap transition pkg) — CDP missing"; \
      rm -rf /var/lib/apt/lists/*; \
    fi; \
    # Build-time hard check: the real browser binary must be executable (so snap-transition false successes never slip through silently again)
    google-chrome-stable --version || chromium --version

# ── ② ASR venv + model pre-download (design §2.2.2; HF via the CN mirror) ──────────────────────
# Layer order: setup (venv+models ~2.7GB, slow) first, app COPY later — changing ASR app code does not re-download models
COPY docker/scripts/40-asr-setup.sh /tmp/40-asr-setup.sh
RUN HF_ENDPOINT="${HF_ENDPOINT}" PIP_MIRROR="${PIP_MIRROR}" /tmp/40-asr-setup.sh && rm /tmp/40-asr-setup.sh
COPY pi-web-ext/aiti-ai-input/server /opt/aiti-asr/app

# ── ③ edge-tts (design §2.2.3: tts.edge feature off by default; tool pre-installed + cache dir pre-created) ──
RUN pip3 install --break-system-packages -i "${PIP_MIRROR}" edge-tts \
    && mkdir -p /home/aiti/.local/bin /opt/aiti/data/aiti-ai-speek/tts-cache \
    && chown -R aiti:aiti /home/aiti/.local /opt/aiti/data/aiti-ai-speek
# After the A12 fix speek locates edge-tts via PATH; in-container pip installs to /usr/local/bin (on PATH)

# ── ④ tunnel binaries + ttyd (design §2.2.4/§2.2.5) ─────────────────────────────────────────
# All versions pinned (latest redirects / asset drift caused silent absences); multi-source racing (github direct +
# 3 gh mirrors — single sources proved flaky); if all four sources fail for cloudflared/ttyd the build fails (hard check);
# ngrok/frpc tolerate failure (equinox has no mirror alternative — WARN, non-blocking).
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) garch="amd64"; garch_f="amd64";; arm64) garch="aarch64"; garch_f="arm64";; esac; \
    try_dl() { out="$1"; shift; for u in "$@"; do curl -fsSL --connect-timeout 20 --retry 2 -o "$out" "$u" && return 0; done; return 1; }; \
    GH="https://github.com"; P1="https://gh-proxy.com/https://github.com"; P2="https://ghproxy.net/https://github.com"; P3="https://ghfast.top/https://github.com"; \
    # cloudflared (default tunnel, required) pinned 2026.8.3
    try_dl /usr/local/bin/cloudflared \
      "$GH/cloudflare/cloudflared/releases/download/2026.8.3/cloudflared-linux-${garch}" \
      "$P1/cloudflare/cloudflared/releases/download/2026.8.3/cloudflared-linux-${garch}" \
      "$P2/cloudflare/cloudflared/releases/download/2026.8.3/cloudflared-linux-${garch}" \
      "$P3/cloudflare/cloudflared/releases/download/2026.8.3/cloudflared-linux-${garch}"; \
    chmod +x /usr/local/bin/cloudflared; \
    # ttyd ([term] phase) pinned 1.7.7 (release assets are bare binaries; naming is kernel-style x86_64/aarch64,
    # not dpkg's amd64/arm64 — building URLs with amd64 once 404'd on every source)
    case "$arch" in amd64) tarch="x86_64";; arm64) tarch="aarch64";; esac; \
    try_dl /usr/local/bin/ttyd \
      "$GH/tsl0922/ttyd/releases/download/1.7.7/ttyd.${tarch}" \
      "$P1/tsl0922/ttyd/releases/download/1.7.7/ttyd.${tarch}" \
      "$P2/tsl0922/ttyd/releases/download/1.7.7/ttyd.${tarch}" \
      "$P3/tsl0922/ttyd/releases/download/1.7.7/ttyd.${tarch}"; \
    chmod +x /usr/local/bin/ttyd && ttyd --version; \
    # ngrok (stable direct link; users configure their own authtoken; failure non-blocking)
    try_dl /tmp/ngrok.tgz "https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-${garch}.tgz" \
      || echo "[full] WARN ngrok download failed (optional)"; \
    (tar -xzf /tmp/ngrok.tgz -C /usr/local/bin ngrok && chmod +x /usr/local/bin/ngrok) || true; rm -f /tmp/ngrok.tgz; \
    # frpc pinned 0.61.1 (frpc is a single binary inside the tar; failure non-blocking)
    try_dl /tmp/frpc.tar.gz \
      "$GH/fatedier/frp/releases/download/v0.61.1/frp_0.61.1_linux_${garch_f}.tar.gz" \
      "$P1/fatedier/frp/releases/download/v0.61.1/frp_0.61.1_linux_${garch_f}.tar.gz" \
      "$P2/fatedier/frp/releases/download/v0.61.1/frp_0.61.1_linux_${garch_f}.tar.gz" \
      "$P3/fatedier/frp/releases/download/v0.61.1/frp_0.61.1_linux_${garch_f}.tar.gz" \
      || echo "[full] WARN frpc download failed (optional)"; \
    (tar -xzf /tmp/frpc.tar.gz -C /tmp "frp_0.61.1_linux_${garch_f}/frpc" \
      && mv "/tmp/frp_0.61.1_linux_${garch_f}/frpc" /usr/local/bin/frpc && chmod +x /usr/local/bin/frpc) || true; \
    rm -rf /tmp/frpc.tar.gz "/tmp/frp_0.61.1_linux_${garch_f}"; \
    cloudflared --version; ttyd --version

# ── ⑤ GUI autostart orchestration script (no systemd in containers → entrypoint phases, design §3.3 full branch) ──
COPY docker/scripts/50-gui-start.sh /usr/local/bin/aiti-gui-start
RUN chmod +x /usr/local/bin/aiti-gui-start

# chromium needs --no-sandbox for the unprivileged in-container user (design §2.1.4); CDP defaults to loopback.
# --no-first-run: a headful fresh profile blocks on the EULA dialog waiting for a human — nobody clicks inside a
# container, so browser startup never completes and the CDP port never opens (smoke-verified); headless skips
# first-run so it is unaffected.
# --user-data-dir: Chrome 136+ security change — remote-debugging-port is silently ignored on the default
# profile and must be paired with a non-default data dir (smoke-verified: window/process alive but 9222 never opens).
# The profile lands in the data volume and persists with the container.
# MODELSCOPE_CACHE matches the 40-asr-setup.sh pre-download dir — runtime (user aiti) reads the same models with zero re-download
ENV AITI_PHASES=piweb,bridge \
    AITI_CHROMIUM_FLAGS="--no-sandbox --no-first-run --no-default-browser-check --user-data-dir=/opt/aiti/data/chrome-profile --remote-debugging-port=9222 --remote-allow-origins=*" \
    AITI_ASR_STREAM_BASE=ws://127.0.0.1:8767 \
    MODELSCOPE_CACHE=/opt/aiti-asr/models

# full layer marker (entrypoint MODE=auto probe)
RUN touch /opt/aiti/.aiti-full

EXPOSE 30142 8777 5900 6080 9222 7681 3389
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
