{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aiti-widget",
  "version": "0.2.0",
  "identifier": "ai.aiti.widget",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "widget-drag"
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Generic always-on-top desktop widget shell",
    "longDescription": "Frameless transparent desktop widget host for captions, floating icons and desktop pets."
  }
}
